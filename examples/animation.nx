// animation.nx — sprite sheet: examples/walker.png has 4 frames of 32x32
// side by side; draw_image_sub_ex cuts out the frame and flip_x turns the
// walker around. Run from the repository root: noxy examples/animation.nx
use github_com.noxylang.noxy_game_engine as game

let FRAME = 32.0
let FRAMES = 4
let SPEED = 120.0            // px per second
let FPS_ANIM = 10.0          // animation frames per second

game.init(480, 200, "Animation")
let sheet: game.Image = game.load_image("examples/walker.png")

let x = 40.0
let facing_right = true
let t = 0.0
while game.running() do
    if game.key_pressed("escape") then
        game.stop()
    end
    let dt: float = game.delta()
    t = t + dt
    if facing_right then
        x = x + SPEED * dt
        if x > 380.0 then
            facing_right = false
        end
    else
        x = x - SPEED * dt
        if x < 40.0 then
            facing_right = true
        end
    end
    let frame = to_int(t * FPS_ANIM) % FRAMES

    game.clear(game.rgb(30, 30, 30))
    game.draw_line(0.0, 160.0, 480.0, 160.0, game.WHITE, 2.0)
    game.draw_image_sub_ex(sheet, to_float(frame) * FRAME, 0.0, FRAME, FRAME, x, 32.0, 4.0, 0.0, 1.0, !facing_right)
    game.draw_text("Escape to quit", 10.0, 176.0, 14, game.WHITE)
    game.flip()
end
game.quit()
