// sprite.nx — loads examples/sprite.png and draws it plain, scaled and
// rotating; a half-transparent, mirrored copy follows the mouse.
// Escape quits.
// Run from the repository root: noxy examples/sprite.nx
use github_com.noxylang.noxy_game_engine as game

game.init(400, 300, "Sprite")
let sprite: game.Image = game.load_image("examples/sprite.png")
print(f"loaded {sprite.width}x{sprite.height}")

let angle = 0.0
while game.running() do
    if game.key_pressed("escape") then
        game.stop()
    end
    angle = angle + 90.0 * game.delta()

    game.clear(game.rgb(30, 30, 30))
    game.draw_image(sprite, 20.0, 20.0)
    game.draw_image_ex(sprite, 100.0, 20.0, 3.0, 0.0, 1.0, false)
    game.draw_image_ex(sprite, 250.0, 100.0, 2.0, angle, 1.0, false)
    let m: game.Point = game.mouse_pos()
    game.draw_image_ex(sprite, m.x - 16.0, m.y - 16.0, 1.0, 0.0, 0.5, true)
    game.draw_text("Escape to quit", 10.0, 270.0, 14, game.WHITE)
    game.flip()
end
game.quit()
